    "structures": [
      {
        "id": "not-just-fr",
        "regex": "(?i)\\bce n['’]est pas (?:(?:seulement|juste)\\s+une?|qu['’]une?)\\b[^.!?\\n]{2,60}[,.] c['’]est\\b",
        "name": "« Ce n'est pas X, c'est Y » (révélation en deux temps)",
        "fix": "Dites directement ce que c'est. La formule existe pour créer un effet, pas pour informer."
      },
      {
        "id": "not-only-fr",
        "regex": "(?i)\\bnon seulement\\b[^.!?\\n]{2,80}\\bmais (?:aussi|également)\\b",
        "name": "« Non seulement X mais aussi Y »",
        "fix": "Deux phrases, ou une seule avec la vraie priorité. La double clause dilue les deux."
      },
      {
        "id": "the-result-fr",
        "regex": "(?i)^\\s*(?:le résultat|le meilleur|le hic|le piège|le problème)\\s*\\?\\s*$",
        "name": "Ligne-question rhétorique d'un seul mot",
        "fix": "Posez la question en entier, ou répondez directement à la ligne suivante."
      },
      {
        "id": "heres-what-fr",
        "regex": "(?i)\\bvoici ce que (?:j'ai|nous avons) appris\\b",
        "name": "« Voici ce que j'ai appris »",
        "fix": "Nommez directement la chose apprise."
      },
      {
        "id": "triad-fr",
        "regex": "(?i)\\b\\w+, \\w+ et \\w+\\.",
        "name": "Triade de trois éléments",
        "fix": "Gardez les deux qui comptent. Trois éléments alignés sont une signature de machine."
      },
      {
        "id": "as-an-ai-fr",
        "regex": "(?i)\\ben tant qu['’]? ?(?:ia|intelligence artificielle|modèle de langage)\\b",
        "name": "« En tant qu'IA »",
        "fix": "Supprimez la phrase. Personne n'a besoin de savoir qui parle."
      },
      {
        "id": "in-summary-fr",
        "regex": "(?i)^\\s*(?:en résumé|pour résumer|en conclusion)\\b",
        "name": "« En résumé » en ouverture d'alinéa",
        "fix": "Le résumé qui répète ce qui précède n'ajoute rien. Coupez-le."
      },
      {
        "id": "engagement-bait-fr",
        "regex": "(?i)\\b(?:d'accord\\?|vous en pensez quoi\\s*\\?|qui d'autre\\b|j'ai tort\\?)",
        "name": "Question-appât d'engagement",
        "fix": "Demandez la seule action que ce post mérite vraiment."
      },
      {
        "id": "stop-scroll-fr",
        "regex": "(?im)^\\s*(?:ne scrollez plus|arrêtez de scroller|attends[,.]? ne scrolle pas)\\b",
        "name": "« Ne scrollez plus »",
        "fix": "Ouvrez sur le contenu. L'injonction est le tell le plus reconnaissable."
      },
      {
        "id": "in-this-video-fr",
        "regex": "(?i)\\b(?:dans (?:cette|cet) (?:vidéo|reel|post)|aujourd'hui je vais vous (?:montrer|apprendre)|je vais vous (?:montrer|apprendre) comment)\\b",
        "name": "Annonce de sommaire (« dans cette vidéo »)",
        "fix": "Commencez par le contenu. Le sommaire est la partie qu'on saute."
      },
      {
        "id": "follow-bait-fr",
        "regex": "(?i)\\b(?:abonnez-vous pour plus|identifiez quelqu'un qui|double tap si|partagez si|commentez si)\\b",
        "name": "Appel à l'action réflexe",
        "fix": "Demandez l'action que ce post gagne vraiment. L'appel générique entraîne à ignorer les suivants."
      }
    ]
